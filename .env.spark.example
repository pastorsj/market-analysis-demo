# Operator environment for ./demo (copy to .env, or point COMPOSE_ENV_FILE at a private file).
# Model IDs, ports, and service URLs are fixed in code and compose.yaml.
# After changing this file, re-prepare OpenShell (scripts/spark/openshell_config.py and
# scripts/spark/openshell_runtime.py prepare-receipt) and run ./demo start --recreate-agent.

# Research is off by default. The agent then serves the UI but refuses to investigate
# (fail closed). To enable research set REMOTE_ROUTING_ENABLED=true together with the
# approved inference endpoint and its key; the key is stored only in an OpenShell provider.
REMOTE_ROUTING_ENABLED=false
NVIDIA_BASE_URL=
NVIDIA_INFERENCE_API_KEY=

# Optional LangSmith export of Relay traces (needs the API key, project, and project URL).
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_PROJECT_URL=
