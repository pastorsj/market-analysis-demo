{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market-shock-document-corpus-v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_kind", "snapshot_id", "normalizer_version", "gate", "data_tier", "vintage_status", "created_at", "captured_at", "cutoff_policy", "issuers", "corpus_sha256", "requirements", "observed_coverage", "sources", "artifacts", "gaps"],
  "properties": {
    "schema_version": {"const": 2},
    "snapshot_kind": {"const": "documents"},
    "snapshot_id": {"type": "string", "pattern": "^documents-[0-9a-f]{16}$"},
    "normalizer_version": {"const": 2},
    "gate": {"enum": ["fixture", "reconstruction", "release"]},
    "data_tier": {"enum": ["ci_fixture", "authoritative_reconstruction", "entitled_local"]},
    "vintage_status": {"enum": ["archived_at_cutoff", "reconstructed_later", "unknown"]},
    "created_at": {"type": "string", "format": "date-time"},
    "captured_at": {"type": "string", "format": "date-time"},
    "cutoff_policy": {"const": "published_at_lte_cutoff"},
    "issuers": {"type": "object", "minProperties": 5},
    "corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requirements": {"type": "array", "minItems": 1},
    "observed_coverage": {"type": "object"},
    "sources": {"type": "array"},
    "artifacts": {"type": "array", "minItems": 2},
    "gaps": {"type": "array"}
  }
}
