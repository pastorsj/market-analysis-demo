{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market-shock-curated-event-catalog-v1",
  "title": "Curated market-shock event catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "catalog_id",
    "calendar",
    "timezone",
    "supported_tickers",
    "categories",
    "events"
  ],
  "properties": {
    "version": {"const": 1},
    "catalog_id": {"const": "curated-shock-events-v1"},
    "calendar": {"const": "XNYS"},
    "timezone": {"const": "America/New_York"},
    "supported_tickers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ticker"}
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/category"}
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/event"}
    }
  },
  "$defs": {
    "ticker": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 96
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category_id", "label", "description", "sort_order"],
      "properties": {
        "category_id": {
          "enum": [
            "ai-competition",
            "regulation-export-controls",
            "banking-liquidity",
            "earnings-guidance"
          ]
        },
        "label": {"type": "string", "minLength": 3, "maxLength": 64},
        "description": {"type": "string", "minLength": 10, "maxLength": 240},
        "sort_order": {"type": "integer", "minimum": 1, "maximum": 32}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "label", "capability", "text"],
      "properties": {
        "question_id": {"$ref": "#/$defs/identifier"},
        "label": {"type": "string", "minLength": 3, "maxLength": 72},
        "capability": {
          "enum": [
            "move-measurement",
            "evidence-review",
            "peer-comparison",
            "historical-analogues",
            "shock-propagation",
            "risk-analysis"
          ]
        },
        "text": {"type": "string", "minLength": 12, "maxLength": 500}
      }
    },
    "market-requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "required_fields", "price_basis"],
      "properties": {
        "required": {"const": true},
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["adjusted_close", "volume"]}
        },
        "price_basis": {"const": "provider_adjusted"}
      }
    },
    "document-requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_for_ready", "requirement_id", "source_kinds"],
      "properties": {
        "required_for_ready": {"const": true},
        "requirement_id": {"$ref": "#/$defs/identifier"},
        "source_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["company_release", "filing", "primary_source"]}
        }
      }
    },
    "news-requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_for_publication", "required_for_ready", "source_kind"],
      "properties": {
        "required_for_publication": {"const": false},
        "required_for_ready": {"const": true},
        "source_kind": {"const": "licensed_news_metadata"}
      }
    },
    "derived-requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_for_ready", "features"],
      "properties": {
        "required_for_ready": {"const": true},
        "features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "event-returns",
              "relative-returns",
              "volume-context",
              "historical-analogues"
            ]
          }
        }
      }
    },
    "source-requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["market", "documents", "licensed_news", "derived_features"],
      "properties": {
        "market": {"$ref": "#/$defs/market-requirement"},
        "documents": {"$ref": "#/$defs/document-requirement"},
        "licensed_news": {"$ref": "#/$defs/news-requirement"},
        "derived_features": {"$ref": "#/$defs/derived-requirement"}
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "layer", "detail"],
      "properties": {
        "code": {
          "enum": [
            "unsupported_missing_news",
            "unsupported_missing_company_release",
            "publication_proof_source_identity",
            "document_http"
          ]
        },
        "layer": {"enum": ["documents", "licensed_news"]},
        "detail": {"type": "string", "minLength": 10, "maxLength": 240}
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limitation_id", "detail"],
      "properties": {
        "limitation_id": {"$ref": "#/$defs/identifier"},
        "detail": {"type": "string", "minLength": 10, "maxLength": 280}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "category_id",
        "title",
        "summary",
        "sort_order",
        "event_session",
        "source_dates",
        "primary_ticker",
        "analysis_tickers",
        "context_instruments",
        "start_session",
        "end_session",
        "default_cutoff",
        "questions",
        "source_requirements",
        "known_gaps",
        "limitations"
      ],
      "properties": {
        "event_id": {"$ref": "#/$defs/identifier"},
        "category_id": {
          "enum": [
            "ai-competition",
            "regulation-export-controls",
            "banking-liquidity",
            "earnings-guidance"
          ]
        },
        "title": {"type": "string", "minLength": 5, "maxLength": 100},
        "summary": {"type": "string", "minLength": 20, "maxLength": 420},
        "sort_order": {"type": "integer", "minimum": 1, "maximum": 10000},
        "event_session": {"type": "string", "format": "date"},
        "source_dates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "format": "date"}
        },
        "primary_ticker": {"$ref": "#/$defs/ticker"},
        "analysis_tickers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/ticker"}
        },
        "context_instruments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/ticker"}
        },
        "start_session": {"type": "string", "format": "date"},
        "end_session": {"type": "string", "format": "date"},
        "default_cutoff": {"type": "string", "format": "date-time"},
        "questions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/question"}
        },
        "source_requirements": {"$ref": "#/$defs/source-requirements"},
        "known_gaps": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/gap"}
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/limitation"}
        }
      }
    }
  }
}
